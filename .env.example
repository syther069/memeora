# Wallet-only target app — server only. Use a dedicated least-privilege PostgreSQL runtime role.
DATABASE_URL=postgresql://memeora_runtime:your-password@localhost:5432/memeora
# Migration-only owner connection (direct, not pooled). Never used by request handlers.
DATABASE_MIGRATION_URL=postgresql://owner:your-password@localhost:5432/memeora
MEMEORA_APP_ORIGIN=http://localhost:3000

# Walrus Memory — server only (Never expose to client / NEXT_PUBLIC)
# Sui object ID for your Walrus Memory account.
MEMWAL_ACCOUNT_ID=your-walrus-memory-account-object-id
# Ed25519 delegate private key (hex or suiprivkey format); never commit a real key.
MEMWAL_KEY=your-ed25519-delegate-private-key
# Encrypts each wallet's Walrus key at rest: 32 random bytes, base64.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MEMEORA_DELEGATE_KEY_SECRET=your-32-byte-base64-secret
MEMWAL_RELAYER_URL=https://relayer.memory.walrus.xyz
MEMWAL_NAMESPACE=memeora

# Tatum — server only (Never expose to client / NEXT_PUBLIC)
TATUM_API_KEY=your-tatum-api-key

# LLM (Groq, https://console.groq.com/keys) — server only
LLM_API_KEY=your-groq-api-key
LLM_MODEL=openai/gpt-oss-120b
