# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Keep the env template public; every real .env file stays ignored.
!.env.example

# Local scratch output
/tmp/

# Installed agent skills (reproducible from skills-lock.json)
/.agents/
.taste-skill/

# Third-party reference documents and source archives (not redistributed)
/*.pdf
/Roboto.zip

# Local editor and agent settings
.claude/settings.local.json
